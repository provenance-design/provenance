politan Museum of Art\u003c/a\u003E, N.Y; \u003ca target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.vam.ac.uk/\"\u003EVictoria &amp; Albert Museum\u003c/a\u003E, London and the \u003ca target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.design-museum.de/en/information.html\"\u003EVitra Design Museum\u003c/a\u003E, among many others.\u003c/p\u003E","browseLink":{"__ref":"client:SXRlbTpmXzE1MDA3MjAy:storyTellingModule(shortTitles:true):tabs:0:browseLink"}},"client:SXRlbTpmXzE1MDA3MjAy:storyTellingModule(shortTitles:true):tabs:0:supplementaryEditorial":{"__id":"client:SXRlbTpmXzE1MDA3MjAy:storyTellingModule(shortTitles:true):tabs:0:supplementaryEditorial","__typename":"WordpressArticlesType","articles":{"__refs":[]}},"client:SXRlbTpmXzE1MDA3MjAy:classification":{"__id":"client:SXRlbTpmXzE1MDA3MjAy:classification","__typename":"ItemClassification","creationDate":"1981"},"SXRlbUNyZWF0b3I6NDEzNDI1NzI6REVTSUdORVI6TUFOVUZBQ1RVUkVSOkJZX0FORF9ET0NVTUVOVEVE":{"__id":"SXRlbUNyZWF0b3I6NDEzNDI1NzI6REVTSUdORVI6TUFOVUZBQ1RVUkVSOkJZX0FORF9ET0NVTUVOVEVE","__typename":"ItemCreator","attribution":"BY_AND_DOCUMENTED","creator":{"__ref":"Q3JlYXRvcjozMDc4"},"id":"SXRlbUNyZWF0b3I6NDEzNDI1NzI6REVTSUdORVI6TUFOVUZBQ1RVUkVSOkJZX0FORF9ET0NVTUVOVEVE"},"Q3JlYXRvcjozMDc4":{"__id":"Q3JlYXRvcjozMDc4","__typename":"Creator","name":"Ron Arad","displayName":"Ron Arad","id":"Q3JlYXRvcjozMDc4"},"client:SXRlbTpmXzE1MDA3MjAy:popularSearchesLink":{"__id":"client:SXRlbTpmXzE1MDA3MjAy:popularSearchesLink","__typename":"LinkData","text":"Chairs","path":"/popular-searches/furniture/seating/chairs/"},"client:SXRlbTpmXzE1MDA3MjAy:breadcrumbs:0":{"__id":"client:SXRlbTpmXzE1MDA3MjAy:breadcrumbs:0","__typename":"LinkData","text":"Home","path":"/","isLinkable":true},"client:SXRlbTpmXzE1MDA3MjAy:breadcrumbs:1":{"__id":"client:SXRlbTpmXzE1MDA3MjAy:breadcrumbs:1","__typename":"LinkData","text":"Furniture","path":"/furniture/","isLinkable":true},"client:SXRlbTpmXzE1MDA3MjAy:breadcrumbs:2":{"__