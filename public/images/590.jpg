04ZDg2NzIzYmFhOGU=","SW50ZXJuYWxCdXlMaW5rVHlwZTo3YTkzNzBhYy1hZTBiLTRkYjEtOWU4MC04ZWNhYjBhNjM1NjE="]},"storyTellingModule(shortTitles:true)":{"__ref":"client:SXRlbTpmXzE1MDA3MjAy:storyTellingModule(shortTitles:true)"},"title":"Ron Arad Rover Chair, circa 1981","isArt":false,"classification":{"__ref":"client:SXRlbTpmXzE1MDA3MjAy:classification"},"creators":{"__refs":["SXRlbUNyZWF0b3I6NDEzNDI1NzI6REVTSUdORVI6TUFOVUZBQ1RVUkVSOkJZX0FORF9ET0NVTUVOVEVE"]},"popularSearchesLink":{"__ref":"client:SXRlbTpmXzE1MDA3MjAy:popularSearchesLink"},"sitemapLinks":null,"breadcrumbs":{"__refs":["client:SXRlbTpmXzE1MDA3MjAy:breadcrumbs:0","client:SXRlbTpmXzE1MDA3MjAy:breadcrumbs:1","client:SXRlbTpmXzE1MDA3MjAy:breadcrumbs:2","client:SXRlbTpmXzE1MDA3MjAy:breadcrumbs:3"]},"seoDescription":"Ron Arad Rover chair 1981, Black leather Rover chair with reclining action.\r\n\r\nRon Arad said he \"hardly designed anything\" when creating his readymade Rover chair\r\n\r\nThe Rover chair was produced using discarded seats from vehicles made by the now-defunct British car company of the same name. The seat is set to make a return to production as an updated version next year.\r\nIsraeli-born designer Ron Arad made his first Rover Chair in 1981 after he grew tired of his job at an architect's practice in north London.\r\n\"I went to a scrapyard behind the Roundhouse on a mission to find a car seat that I would make a domestic chair out of,\" \"I knew I had to choose one [model of car] and the Rover won because it was a nice fitting leather chair that was fixed to the car at four points so it was easy for me to fix it onto the frame.\"\r\nArad adapted tubular steel Kee Klamps that are commonly used in milking stalls to make the frame for the chair, which features curving sections that form the armrests clamped to horizontal supports.\r\n\"I hardly designed anything – it was all readymade,\" Arad added. \"I felt it was more to do with [Marcel] Duchamp and found objects than it was with [Jean] Prouvé or [Marcel] Breuer and with furniture design, but I was wrong because I once found a photograph of a chair by Prouvé that looks amazingly like it.\"\r\nThe first chairs were manufactured by Arad at his studio in Covent Garden and Rolf Fehlbaum, the chairman of design brand Vitra, was one of the first people to turn up and buy one. A year later Arad said fashion designer Jean Paul Gaultier knocked on the door and asked to buy six.\r\n\"After that it became – by my standards in those days – a bestseller and I couldn't get enough of them so I employed two people with a van to scour the country's scrapyards and get every Rover seat they could get their hands on,\" Arad recalled.\r\nHe worked with a local upholsterer specialised in automotive trimming to renovate the seats and continued producing the chair under his One Off label until 1989.\r\n\"It was so successful it was boring so I declared the last hundred,\" Arad said. \"I kept the first two and they were in the house and my daughters grew up on them and the cat sat on them. Then, when they were exhibited at my show No Discipline at the Pompidou Centre I was told off for touching my own chair without wearing white gloves.”\r\n\r\nDimensions:?Height: 37” inches / 93.98cm\r\nWidth: 27” inches / 68.28 cm\r\nDepth: 34” inches / 86.36 cm?seat height: 14.5” inches / 36.83 cm.","pdpDetailsDisplay":{"__refs":["client:SXRlbTpmXzE1MDA3MjAy:pdpDetailsDisplay:0","client:SXRlbTpmXzE1MDA3MjAy:pdpDetailsDisplay:1","client:SXRlbTpmXzE1MDA3MjAy:pdpDetailsDisplay:2","client:SXRlbTpmXzE1MDA3MjAy:pdpDetailsDisplay:3","client:SXRlbTpmXzE1MDA3MjAy:pdpDetailsDisplay:4","client:SXRlbTpmXzE1MDA3MjAy:pdpDetailsDisplay:5","client:SXRlbTpmXzE1MDA3MjAy:pdpDetailsDisplay:6","client:SXRlbTpmXzE1MDA3MjAy:pdpDetailsDisplay:7","client:SXRlbTpmXzE1MDA3MjAy:pdpDetailsDisplay:8","client:SXRlbTpmXzE1MDA3MjAy:pdpDetailsDisplay:9"]},"isAvailable":false,"isSold":true,"hasPrivateListing":false,"isListingUnlisted":false,"displayInfo":{"__ref":"client:SXRlbTpmXzE1MDA3MjAy:displayInfo"},"defaultSkuId":"f_15007202S1","vertical":"furniture","videoVimeo":null,"reviews":{"__ref":"client:SXRlbTpmXzE1MDA3MjAy:reviews"},"isMultiSku":false,"description":"Ron Arad Rover chair 1981, Black leather Rover chair with reclining action.\r\n\r\nRon Arad said he \"hardly designed anything\" when creating his readymade Rover chair\r\n\r\nThe Rover chair was produced using discarded seats from vehicles made by the now-defunct British car company of the same name. The seat is set to make a return to production as an updated version next year.\r\nIsraeli-born designer Ron Arad made his first Rover Chair in 1981 after he grew tired of his job at an architect's practice in north London.\r\n\"I went to a scrapyard behind the Roundhouse on a mission to find a car seat that I would make a domestic chair out of,\" \"I knew I had to choose one [model of car] and the Rover won because it was a nice fitting leather chair that was fixed to the car at four points so it was easy for me to fix it onto the frame.\"\r\nArad adapted tubular steel Kee Klamps that are commonly used in milking stalls to make the frame for the chair, which features curving sections that form the armrests clamped to horizontal supports.\r\n\"I hardly designed anything – it was all readymade,\" Arad added. \"I felt it was more to do with [Marcel] Duchamp and found objects than it was with [Jean] Prouvé or [Marcel] Breuer and with furniture design, but I was wrong because I once found a photograph of a chair by Prouvé that looks amazingly like it.\"\r\nThe first chairs were manufactured by Arad at his studio in Covent Garden and Rolf Fehlbaum, the chairman of design brand Vitra, was one of the first people to turn up and buy one. A year later Arad said fashion designer Jean Paul Gaultier knocked on the door and asked to buy six.\r\n\"After that it became – by my standards in those days – a bestseller and I couldn't get enough of them so I employed two people with a van to scour the country's scrapyards and get every Rover seat they could get their hands on,\" Arad recalled.\r\nHe worked with a local upholsterer specialised in automotive trimming to renovate the seats and continued producing the chair under his One Off label until 1989.\r\n\"It was so successful it was boring so I declared the last hundred,\" Arad said. \"I kept the first two and they were in the house and my daughters grew up on them and the cat sat on them. Then, when they were exhibited at my show No Discipline at the Pompidou Centre I was told off for touching my own chair without wearing white gloves.”\r\n\r\nDimensions:?Height: 37” inches / 93.98cm\r\nWidth: 27” inches / 68.28 cm\r\nDepth: 34” inches / 86.36 cm?seat height: 14.5” inches / 36.83 cm.","measurement":{"__ref":"client:SXRlbTpmXzE1MDA3MjAy:measurement"},"sortedPhotos":{"__refs":["SXRlbVBob3RvOjExXzkyMjlfMTU1OTkyNDIyM183MjU4ODA=","SXRlbVBob3RvOjExXzkyMjlfMTU1OTg5NDU4M181Mjc4OTA=","SXRlbVBob3RvOjExXzkyMjlfMTU1OTg5NDU4M181Mjc3NTA=","SXRlbVBob3RvOjExXzkyMjlfMTU1OTg5NDU4M181Mjc3MzA=","SXRlbVBob3RvOjExXzkyMjlfMTU1OTg5NDU4M181Mjc3OTA=","SXRlbVBob3RvOjExXzkyMjlfMTU1OTg5NDU4M181Mjc4MTA=","SXRlbVBob3RvOjExXzkyMjlfMTU1OTg5NDU4M181Mjc4MzA=","SXRlbVBob3RvOjExXzkyMjlfMTU1OTg5NDU4M181Mjc4NTA=","SXRlbVBob3RvOjExXzkyMjlfMTU1OTg5NDU4M181Mjc4NzA=","SXRlbVBob3RvOjExXzkyMjlfMTU1OTg5NDU4M181Mjc5MTA=","SXRlbVBob3RvOjExXzkyMjlfMTU1OTg5NDU4M181Mjc3NzA="]},"viewInRoomPhotos":{"__refs":[]},"firstPhotoWebPath(size:\"small\")":"https://a.1stdibscdn.com/ron-arad-rover-chair-circa-1981-for-sale/1121189/f_150072021559924222184/15007202_master.jpeg?width=240","isCustomizable":false,"attributes":{"__ref":"client:SXRlbTpmXzE1MDA3MjAy:attributes"},"isJewelry":false,"isDyoCustomizable":false,"displayPrice(buyerId:\"\",catchNonFatalErrors:false,isTrade:false)":{"__refs":["client:SXRlbTpmXzE1MDA3MjAy:displayPrice(buyerId:\"\",catchNonFatalErrors:false,isTrade:false):0"]},"leadTimeDisplay":null,"displayPrice(buyerId:\"\",catchNonFatalErrors:false,isTrade:false,priceBookName:\"\",userCountryCode:\"\")":{"__refs":["client:SXRlbTpmXzE1MDA3MjAy:displayPrice(buyerId:\"\",catchNonFatalErrors:false,isTrade:false,priceBookName:\"\",userCountryCode:\"\"):0"]},"sourceLocale":"en-US","microdata(priceBookName:\"\",userCountryCode:\"\")":"[{\"@context\":\"http://schema.org\",\"@type\":\"Product\",\"name\":\"Ron Arad Rover Chair, circa 1981\",\"description\":\"Ron Arad Rover chair 1981, Black leather Rover chair with reclining action.\\r\\n\\r\\nRon Arad said he \\\"hardly designed anything\\\" when creating his readymade Rover chair\\r\\n\\r\\nThe Rover chair was produced using discarded seats from vehicles made by the now-defunct British car company of the same name. The seat is set to make a return to production as an updated version next year.\\r\\nIsraeli-born designer Ron Arad made his first Rover Chair in 1981 after he grew tired of his job at an architect's practice in north London.\\r\\n\\\"I went to a scrapyard behind the Roundhouse on a mission to find a car seat that I would make a domestic chair out of,\\\" \\\"I knew I had to choose one [model of car] and the Rover won because it was a nice fitting leather chair that was fixed to the car at four points so it was easy for me to fix it onto the frame.\\\"\\r\\nArad adapted tubular steel Kee Klamps that are commonly used in milking stalls to make the frame for the chair, which features curving sections that form the armrests clamped to horizontal supports.\\r\\n\\\"I hardly designed anything – it was all readymade,\\\" Arad added. \\\"I felt it was more to do with [Marcel] Duchamp and found objects than it was with [Jean] Prouvé or [Marcel] Breuer and with furniture design, but I was wrong because I once found a photograph of a chair by Prouvé that looks amazingly like it.\\\"\\r\\nThe first chairs were manufactured by Arad at his studio in Covent Garden and Rolf Fehlbaum, the chairman of design brand Vitra, was one of the first people to turn up and buy one. A year later Arad said fashion designer Jean Paul Gaultier knocked on the door and asked to buy six.\\r\\n\\\"After that it became – by my standards in those days – a bestseller and I couldn't get enough of them so I employed two people with a van to scour the country's scrapyards and get every Rover seat they could get their hands on,\\\" Arad recalled.\\r\\nHe worked with a local upholsterer specialised in automotive trimming to renovate the seats and continued producing the chair under his One Off label until 1989.\\r\\n\\\"It was so successful it was boring so I declared the last hundred,\\\" Arad said. \\\"I kept the first two and they were in the house and my daughters grew up on them and the cat sat on them. Then, when they were exhibited at my show No Discipline at the Pompidou Centre I was told off for touching my own chair without wearing white gloves.”\\r\\n\\r\\nDimensions:?Height: 37” inches / 93.98cm\\r\\nWidth: 27” inches / 68.28 cm\\r\\nDepth: 34” inches / 86.36 cm?seat height: 14.5” inches / 36.83 cm.\",\"image\":[{\"@context\":\"http://schema.org\",\"@type\":\"ImageObject\",\"author\":\"\",\"caption\":\"Ron Arad Rover Chair, circa 1981\",\"contentUrl\":\"https://a.1stdibscdn.com/ron-arad-rover-chair-circa-1981-for-sale/1121189/f_150072021559924222184/15007202_master.jpeg?width=768\",\"thumbnailUrl\":\"https://a.1stdibscdn.com/ron-arad-rover-chair-circa-1981-for-sale/1121189/f_150072021559924222184/15007202_master.jpeg?width=768\",\"uploadDate\":\"2019-06-07T04:04:22.000-04:00\",\"representativeOfPage\":true},{\"@context\":\"http://schema.org\",\"@type\":\"ImageObject\",\"author\":\"\",\"caption\":\"Ron Arad Rover chair 1981, Black leather Rover chair with reclining action.\\r\\n\\r\\nRon Arad said he \\\"hardly designed anything\\\" when creating his readymade Rover chair\\r\\n\\r\\nThe Rover chair was produced using discarded seats from vehicles made by the\",\"contentUrl\":\"https://a.1stdibscdn.com/ron-arad-rover-chair-circa-1981-for-sale-picture-2/f_